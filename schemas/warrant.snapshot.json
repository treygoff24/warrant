{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapshotManifest",
  "description": "The exact source identity used by all downstream artifacts.",
  "type": "object",
  "properties": {
    "capture": {
      "$ref": "#/$defs/Capture"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "excluded": {
      "$ref": "#/$defs/SnapshotExclusions"
    },
    "kind": {
      "$ref": "#/$defs/SnapshotKind"
    },
    "object_format": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "taken_at": {
      "type": "string"
    },
    "tree": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "kind",
    "tree",
    "object_format",
    "capture",
    "excluded",
    "taken_at"
  ],
  "$defs": {
    "Capture": {
      "description": "How snapshot bytes were captured.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "manifest_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "SnapshotExclusions": {
      "description": "Counts and limits deliberately excluded from a snapshot.",
      "type": "object",
      "properties": {
        "ignored_count_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ignored_files": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "oversize": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "submodules": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "submodules",
        "oversize"
      ]
    },
    "SnapshotKind": {
      "description": "The exact source kind represented by a snapshot.",
      "type": "string",
      "enum": [
        "commit",
        "index",
        "worktree",
        "tree"
      ]
    }
  }
}
