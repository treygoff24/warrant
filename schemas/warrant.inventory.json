{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InventoryDocument",
  "description": "The complete classified inventory document.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      }
    },
    "next_cursor": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "default": null,
      "minimum": 0
    },
    "schema_version": {
      "type": "string"
    },
    "snapshot": {
      "description": "The snapshot this inventory classifies (spec 4.5). Always emitted; optional only\nso documents written before it existed still deserialize.",
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summary": {
      "$ref": "#/$defs/InventorySummary"
    },
    "total": {
      "type": "integer",
      "format": "uint64",
      "default": 0,
      "minimum": 0
    },
    "truncated": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries",
    "summary"
  ],
  "$defs": {
    "Capture": {
      "description": "How snapshot bytes were captured.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "manifest_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "Entrypoint": {
      "description": "A runtime-visible entrypoint and the basis that established it.",
      "type": "object",
      "properties": {
        "basis": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "basis",
        "by"
      ]
    },
    "GeneratedAbsent": {
      "description": "A generated declaration with no captured match: a glob that matched no snapshot\npath, or a declared path present only as an ignored file.",
      "type": "object",
      "properties": {
        "declaration": {
          "type": "string",
          "default": ""
        },
        "producer": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "GeneratedBy": {
      "description": "Producer provenance for generated content.",
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "producer": {
          "type": "string"
        },
        "reproducible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "producer",
        "reproducible"
      ]
    },
    "GeneratedDrift": {
      "description": "A reproducible generated file whose producer, re-run over the snapshot, wrote\ndifferent bytes (spec 5.3, `generated-drift`).",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "producer"
      ]
    },
    "InventoryClass": {
      "description": "The exclusive classification assigned to an inventory path.",
      "type": "string",
      "enum": [
        "source",
        "test",
        "config",
        "script",
        "migration",
        "schema",
        "generated",
        "vendored",
        "asset",
        "doc",
        "build-output",
        "submodule",
        "ignored",
        "unknown",
        "unread"
      ]
    },
    "InventoryEntry": {
      "description": "One classified path in the inventory denominator.",
      "type": "object",
      "properties": {
        "blob": {
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/InventoryClass"
        },
        "entrypoints": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Entrypoint"
          }
        },
        "generated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "unread": {
          "type": [
            "string",
            "null"
          ]
        },
        "vendored_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/VendoredFrom"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "class",
        "by",
        "reason"
      ]
    },
    "InventorySummary": {
      "description": "Completeness accounting for the entire inventory.",
      "type": "object",
      "properties": {
        "by_class": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "generated_absent": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GeneratedAbsent"
          }
        },
        "generated_drift": {
          "description": "Drift found by `inventory --verify-generated`; null when producers were not\nre-run, which is not the same claim as an empty list (spec 12.2).",
          "type": [
            "array",
            "null"
          ],
          "default": null,
          "items": {
            "$ref": "#/$defs/GeneratedDrift"
          }
        },
        "ignored_files": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "submodules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Submodule"
          }
        },
        "unit_aliases": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitAliasTable"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unowned_source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unread": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnreadPath"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "files",
        "by_class",
        "unread",
        "unowned_source",
        "unknown",
        "submodules"
      ]
    },
    "SnapshotExclusions": {
      "description": "Counts and limits deliberately excluded from a snapshot.",
      "type": "object",
      "properties": {
        "ignored_count_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ignored_files": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "oversize": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "submodules": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "submodules",
        "oversize"
      ]
    },
    "SnapshotKind": {
      "description": "The exact source kind represented by a snapshot.",
      "type": "string",
      "enum": [
        "commit",
        "index",
        "worktree",
        "tree"
      ]
    },
    "SnapshotManifest": {
      "description": "The exact source identity used by all downstream artifacts.",
      "type": "object",
      "properties": {
        "capture": {
          "$ref": "#/$defs/Capture"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "excluded": {
          "$ref": "#/$defs/SnapshotExclusions"
        },
        "kind": {
          "$ref": "#/$defs/SnapshotKind"
        },
        "object_format": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "taken_at": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repo",
        "kind",
        "tree",
        "object_format",
        "capture",
        "excluded",
        "taken_at"
      ]
    },
    "Submodule": {
      "description": "A submodule recorded but not descended.",
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "commit"
      ]
    },
    "UnitAliasTable": {
      "description": "The alias-table source, if any, that applies to one inventory unit.",
      "type": "object",
      "properties": {
        "alias_table": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "by": {
          "type": "string",
          "default": ""
        },
        "unit": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "UnreadPath": {
      "description": "A path Warrant could not read and the reason why.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ]
    },
    "VendoredFrom": {
      "description": "Source provenance for vendored content.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "treatment": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "version",
        "treatment"
      ]
    }
  }
}
